        " #購入金額の定義\n",
        "def purchase_price(price,tax):\n",
        "  #　与えられたpriceと引数taxを加算し、変数に代入する\n",
        "  total= price + price*tax/100\n",
        "\n",
        "  #変数のtotal値を出力\n",
        "  print(f\"{total}円\")\n",
        "\n",
        "purchase_price(110, 10)"
      ],
