        " #購入金額の定義\n",
        "def purchase_price(price,tax) ->int:\n",
        "  #　与えられたpriceと引数taxを加算し、変数に代入する\n",
        "  total = price + price*tax/100\n",
        "  return(total)\n",
        "  #変数のtotal値を出力\n",
        "\n",
        "A = purchase_price(110, 10)\n",
        "print(f\"{A}円\")"
      ],
